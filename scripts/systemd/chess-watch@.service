[Unit]
Description=Chess GPT: snapshot evaluation watcher for stream-large-%i
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
Environment=UV=@UV@
ExecStart=@ROOT@/scripts/stream-watch.sh %i
Restart=always
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=120
StandardOutput=append:@ROOT@/data/logs/watch-stream-large-%i.log
StandardError=append:@ROOT@/data/logs/watch-stream-large-%i.log

[Install]
WantedBy=default.target
