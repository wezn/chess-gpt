[Unit]
Description=Chess GPT: round-robin streaming trainer (A, B, C)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
Environment=UV=@UV@
ExecStart=@ROOT@/scripts/stream-train.sh
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=120
StandardOutput=append:@ROOT@/data/logs/stream-large.log
StandardError=append:@ROOT@/data/logs/stream-large.log

[Install]
WantedBy=default.target
