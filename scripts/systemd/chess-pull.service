[Unit]
Description=Chess GPT: streaming data pull (Lichess, month by month)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=@UV@ run --no-sync python -m chessgpt.data.lichess configs/data/lichess-stream.yaml
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=120
StandardOutput=append:@ROOT@/data/logs/lichess-stream.log
StandardError=append:@ROOT@/data/logs/lichess-stream.log

[Install]
WantedBy=default.target
